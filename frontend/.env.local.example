# Copy this file to .env.local (which is gitignored) and fill in real values.
# .env.local is only used by the Next.js frontend — the Scala backend is untouched.

# Required for AI Mode's plan generation (Life Goal Planner page).
# Free — no credit card needed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — which Gemini model to use. Defaults to gemini-3-flash-preview
# (latest free-tier Flash). Set to gemini-2.5-flash if the preview model is
# ever renamed/retired.
# GEMINI_MODEL=gemini-3-flash-preview

# Optional — powers the real "Google search" step that grounds the AI's plan.
# Also has a free tier (100 queries/day). If either value is left blank, AI Mode
# still works, it just skips the search step and relies on Gemini's own knowledge.
# Set up a Custom Search Engine at https://programmablesearchengine.google.com/
# and get an API key at https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
